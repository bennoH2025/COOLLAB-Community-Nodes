// To learn how to write nodes, see https://coollab-art.com/Tutorials/Writing%20Nodes/Intro

INPUT UV->sRGB_StraightA 'Input'; /// The image to grade

// Basic Color Adjustments
INPUT float 'Brightness'; /// Brightness adjustment (-1 to 1, 0 = no change)
INPUT float 'Contrast'; /// Contrast adjustment (-1 to 1, 0 = no change)
INPUT float 'Saturation'; /// Color saturation (0 = grayscale, 1 = normal, 2 = hyper-saturated)
INPUT float 'Hue Rotation'; /// Rotate the hue (0 to 1 = 0° to 360°)

// RGB to HSV conversion
vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// HSV to RGB conversion
vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

sRGB_StraightA main(UV uv)
{
    // Get input color
    vec4 color = 'Input'(uv);
    vec3 rgb = color.rgb;
    
    // ===== BRIGHTNESS =====
    rgb = rgb + 'Brightness';
    
    // ===== CONTRAST =====
    float contrast_factor = 1.0 + 'Contrast';
    rgb = (rgb - 0.5) * contrast_factor + 0.5;
    
    rgb = clamp(rgb, 0.0, 1.0);
    
    // ===== SATURATION & HUE ROTATION =====
    vec3 hsv = rgb2hsv(rgb);
    
    // Apply saturation
    hsv.y *= 'Saturation';
    
    // Apply hue rotation
    hsv.x = fract(hsv.x + 'Hue Rotation');
    
    rgb = hsv2rgb(hsv);
    rgb = clamp(rgb, 0.0, 1.0);
    
    // Return with original alpha
    return vec4(rgb, color.a);
}
