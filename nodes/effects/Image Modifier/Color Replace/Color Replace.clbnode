// Color Replace - Replace a color range with a new color
//
// Idea and project coordination by bennoH.
// Coding by claude.ai in the Sonnet-4.5 model of Anthropic PBC on a "KostenlosPlan" of bennoH.
// This Coollab node is licensed under GPLv3.0 by bennoH. 2026

// To learn how to write nodes, see https://coollab-art.com/Tutorials/Writing%20Nodes/Intro

INPUT UV->sRGB_StraightA 'Input'; /// The image to process

INPUT float '--- Select Color ---';
INPUT sRGB 'Target Color'; /// The color to replace
INPUT float 'Tolerance'; /// How similar colors must be to be replaced (0 = exact match, 1 = all colors)
INPUT float 'Softness'; /// Edge softness of the selection (0 = hard edge, 1 = very soft)
INPUT bool 'Show Selection'; /// Display the selection mask in bright green

INPUT float '--- Replacement ---';
INPUT float 'Hue Shift'; /// Shift the hue of selected area (0 to 1 = 0° to 360°)
INPUT float 'Saturation'; /// Adjust saturation of selected area (0 = grayscale, 1 = original, 2 = hyper-saturated)
INPUT float 'Brightness'; /// Adjust brightness of selected area (-1 to 1, 0 = no change)

// RGB to HSV conversion
vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// HSV to RGB conversion
vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

sRGB_StraightA main(UV uv)
{
    // Get input color
    vec4 color = 'Input'(uv);
    vec3 rgb = color.rgb;
    
    // Calculate color distance to target color
    vec3 target = 'Target Color';
    float distance = length(rgb - target);
    
    // Create mask based on tolerance and softness
    float mask = 1.0 - smoothstep('Tolerance' - 'Softness', 'Tolerance' + 'Softness', distance);
    
    // If "Show Selection" is enabled, display mask in bright green
    if ('Show Selection') {
        vec3 green = vec3(0.0, 1.0, 0.0); // Bright/toxic green
        vec3 result = mix(vec3(0.0), green, mask);
        return vec4(result, color.a);
    }
    
    // Convert to HSV for color adjustments
    vec3 hsv = rgb2hsv(rgb);
    
    // Apply adjustments only to selected area
    hsv.x = fract(hsv.x + 'Hue Shift' * mask);
    hsv.y = hsv.y * mix(1.0, 'Saturation', mask);
    hsv.z = hsv.z + 'Brightness' * mask;
    
    // Convert back to RGB
    rgb = hsv2rgb(hsv);
    rgb = clamp(rgb, 0.0, 1.0);
    
    // Return with original alpha
    return vec4(rgb, color.a);
}
